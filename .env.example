# ---------------------------------------------------------------------------
# MCP server (npm run server)
# ---------------------------------------------------------------------------

# Hookdeck Outpost (managed). Create an API key in the Hookdeck dashboard:
# your Outpost project > Settings > Secrets.
OUTPOST_API_KEY=
OUTPOST_API_BASE_URL=https://api.outpost.hookdeck.com/2025-07-01

# Port the MCP server listens on. The MCP endpoint is http://localhost:3000/mcp
PORT=3000

# Demo-only bearer auth: comma-separated token=principal pairs.
# Production (and ChatGPT) needs OAuth instead. See README.
MCP_TOKENS=dev-token-alice=alice,dev-token-bob=bob

# DEV ONLY. Principal for /mcp requests that send no Authorization header, so a
# client without OAuth (for example ChatGPT developer mode with "No
# Authentication") can subscribe. Anyone who can reach the server acts as this
# principal. Leave empty to require a token.
ANONYMOUS_PRINCIPAL=

# Log the JSON-RPC method and user agent of every /mcp request.
LOG_MCP_REQUESTS=false

# Subscription lifetime the server grants (milliseconds).
# The client's ttlMs suggestion is honored within [MIN, MAX].
SUBSCRIPTION_DEFAULT_TTL_MS=3600000
SUBSCRIPTION_MAX_TTL_MS=3600000
SUBSCRIPTION_MIN_TTL_MS=60000

# How often expired subscriptions are removed from Outpost.
SWEEP_INTERVAL_MS=30000

# How long a successful callback verification is cached per (principal, url).
VERIFICATION_CACHE_TTL_MS=86400000

# How long the previous secret keeps signing deliveries after a rotation.
SECRET_ROTATION_GRACE_MS=600000

# Where subscription metadata is stored (JSON file). Secrets are not stored here.
STORE_FILE=data/subscriptions.json

# Outpost tenant ids are derived from the principal: <prefix><principal>.
OUTPOST_TENANT_PREFIX=mcp_

# DEV ONLY. Allows http:// and private/loopback callback URLs (for example
# http://localhost:4000). Leave false when the server is reachable publicly.
ALLOW_LOCAL_CALLBACKS=false

# ---------------------------------------------------------------------------
# Test subscriber (npm run client)
# ---------------------------------------------------------------------------

MCP_SERVER_URL=http://localhost:3000/mcp
MCP_TOKEN=dev-token-alice

# Local port for the webhook receiver.
RECEIVER_PORT=4000

# Public base URL that forwards to RECEIVER_PORT. Usually leave this empty and
# run `npm run tunnel`: the client then uses the tunnel's URL from .tunnel-url.
# With neither, the client uses http://localhost:RECEIVER_PORT (only works with
# ALLOW_LOCAL_CALLBACKS=true and without Outpost in the loop, because managed
# Outpost cannot reach your laptop).
PUBLIC_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Demo order trigger (npm run order)
# ---------------------------------------------------------------------------
DEMO_STORE_URL=http://localhost:3000
